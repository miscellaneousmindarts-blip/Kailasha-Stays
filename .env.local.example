# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Server-only. NEVER prefix with NEXT_PUBLIC_ and never commit the real value.
# Supabase → Project Settings → API → service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Random string guarding the iCal export feeds. Generate with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ICAL_EXPORT_SECRET=

# Owner WhatsApp number in international format, digits only (91 = India)
NEXT_PUBLIC_OWNER_WHATSAPP=919999999999

# Public base URL of the site (used for portal links, sitemap, OG images)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
