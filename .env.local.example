# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Server-only. NEVER prefix with NEXT_PUBLIC_ and never commit the real value.
# Supabase → Project Settings → API → service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Random string guarding the iCal export feeds. Generate with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ICAL_EXPORT_SECRET=

# Authorizes the scheduled /api/cron/sync-calendars route (pg_cron -> pg_net
# -> this route). Generate the same way as above, and use the SAME value in
# supabase/migrations/0002_calendar_sync_cron.sql's cron.schedule call.
CRON_SECRET=

# The WhatsApp number, contact phone/email and business name are NOT set here.
# They live in the site_settings table and are edited in Admin → Settings.

# Public base URL of the site (used for portal links, sitemap, OG images)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Which tenant is served at the bare path of a non-platform host (the
# vercel.app deployment URL, localhost). Retired by phase C4, when the
# platform apex gets a landing page of its own. See lib/tenant.ts.
NEXT_PUBLIC_PRIMARY_TENANT_SLUG=kailasha-stays

# Domains under which tenants are reachable at {slug}.{domain}. Comma-
# separated — adding a second platform domain is a config change, not a code
# change. Leave EMPTY in local dev unless you're testing host routing, in
# which case set it and send a matching Host header. See lib/hosts.ts.
NEXT_PUBLIC_PLATFORM_DOMAINS=deogharbnb.space

# The one host that serves /admin and /superadmin. Requests for those paths
# on a tenant subdomain are redirected here, so the auth cookie is never
# scoped to a domain shared with every tenant. Must also be listed in
# Supabase → Authentication → URL Configuration → Redirect URLs.
NEXT_PUBLIC_ADMIN_HOST=deogharbnb.space
